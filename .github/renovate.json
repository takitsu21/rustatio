{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Paris",
  "schedule": ["* 0-5 * * 1"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "groupName": "Rust dependencies (major)"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies (non-major)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "UI dependencies (major)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "UI dependencies (non-major)"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "groupName": "Docker images (major)"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker images (non-major)"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "groupName": "mise tools (major)"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "mise tools (non-major)"
    },
    {
      "matchManagers": ["docker-compose"],
      "pinDigests": false
    }
  ]
}
